# Dependencies
node_modules/
.pnp
.pnp.js

# Production build
dist/
dist-ssr/

# Environment variables — never commit real credentials
.env
.env.local
.env.*.local

# Editor/OS
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
.vscode/settings.json

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Supabase local dev (contains secrets)
supabase/.branches/
supabase/.temp/

# TypeScript build-mode cache (tsc -b, used by npm run type-check)
*.tsbuildinfo

# Wiki screenshot stack: generated credentials, never committed
supabase-wiki/.runtime/

# Beim Bauen erzeugt (scripts/generate-sitemap.mjs), deshalb nicht versioniert:
# die Datei aenderte sich bei jedem Build und stand dauerhaft als Aenderung im
# Status. Ausgeliefert wird sie weiterhin — der Build legt sie an, und
# robots.txt verweist darauf.
public/sitemap.xml

# Zustand der Supabase-CLI, keine Projektdatei
supabase/.temp/

# Laufzeitspuren der Baseline-Auffrischung: die Sperre verhindert, dass
# Auffrischen und Einspielen sich ueberlappen, die Buehne haelt die noch nicht
# veroeffentlichte Generation. Beides gehoert nicht ins Repo.
supabase-test/baseline/.baseline.lock
supabase-test/baseline/.stage.*

# Python-Bytecode der Baseline-Hilfsskripte
__pycache__/
*.pyc
