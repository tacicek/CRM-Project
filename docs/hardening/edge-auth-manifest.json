    "generate-sitemap":              { "model": "public-safe",     "deployed": true,  "repo_source": true, "disposition": "undeploy", "note": "Marktplatz-Sitemap (/partner-werden, /preise, SEO-Landingpages). Liest nur veroeffentlichte blog_posts." },

    "_shared":                       { "model": "infrastructure",  "deployed": true,  "repo_source": true, "drift": "tree", "note": "Kein Endpunkt. 44 Dateien ausgerollt gegen 64 im Repo." }
  },
