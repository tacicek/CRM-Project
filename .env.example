# ─────────────────────────────────────────────────────────
# Supabase (required)
# Get these from: https://supabase.com/dashboard → Project Settings → API
# ─────────────────────────────────────────────────────────
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# ─────────────────────────────────────────────────────────
# Email (Resend)
#
# NEVER as VITE_*: variables with that prefix are inlined into the browser
# bundle at build time. The Resend key is a server-side secret.
#   • per company  → table `company_secrets` (RLS on, no policy, server only)
#   • global fallback → edge secret RESEND_API_KEY
# ─────────────────────────────────────────────────────────

# ─────────────────────────────────────────────────────────
# App identity
# ─────────────────────────────────────────────────────────
VITE_APP_NAME=CRM
VITE_APP_URL=

# ─────────────────────────────────────────────────────────
# Edge Function secrets (set via: supabase secrets set KEY=value)
# These are NOT loaded client-side — server-side only
# ─────────────────────────────────────────────────────────
# APP_NAME=CRM
# SITE_URL=https://www.mycompany.com
# DASH_APP_URL=https://crm.mycompany.com
# SENDER_EMAIL=noreply@mycompany.com
# SENDER_NAME=CRM
# ADMIN_EMAIL=admin@mycompany.com
# CALENDAR_EMAIL=termine@mycompany.com

# ─────────────────────────────────────────────────────────
# Inbound email → lead (Edge Function secrets, server-side only)
# Set via: supabase secrets set KEY=value
# ─────────────────────────────────────────────────────────
# RESEND_WEBHOOK_SECRET=            # Svix signing secret(s) of the Resend webhook endpoint(s), whsec_...
#                                   Comma-separated when several Resend accounts deliver here (one secret per account).
# RESEND_API_KEY=                   # used to fetch the message body; per-company key on companies.resend_api_key wins
# INBOUND_EMAIL_ENABLED=true        # global kill switch. NOTE: on the Coolify setup the edge container
#                                   gets a fixed environment list from the compose file, so this variable
#                                   cannot be set there. The operable switch is a per-company api_keys row:
#                                   key_name='inbound_email_enabled', key_value='false'.
# INBOUND_EMAIL_AUTO_APPROVE_THRESHOLD=0.85
# INBOUND_EMAIL_REVIEW_THRESHOLD=0.60
# INBOUND_EMAIL_MAX_BODY_CHARS=30000
# INBOUND_EMAIL_MAX_PROCESSING_ATTEMPTS=3
# INBOUND_EMAIL_DEFAULT_COMPANY_ID=  # fallback when no api_keys row (key_name='inbound_email_alias') matches the recipient
